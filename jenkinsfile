pipeline {
    agent { label 'worker1' }
    environment {
        aws_access_key = credentials('aws_access_key-id')
        aws_secret_key = credentials('aws_secret_key')
        aws_region = 'us-east-1'
    triggers {
        githubPush()
    }
    stages {
        stage('Checkout') {
            steps {
                git branch: 'terraform', url: 'https://github.com/rnsingh2025/Terraform-projects.git'
            }
        }
        stage('Terraform Init') {
            steps {
                sh 'terraform init'
            }
        }
      stage('Terraform Plan') {
            steps {
                sh 'terraform plan'
            }
        }
        stage('Terraform apply/destroy') {
            steps {
                sh 'terraform destroy -auto-approve'
            }
        }
    }
    

    post {
        always {
        echo 'Cleaning up...'
        }
    }

}
